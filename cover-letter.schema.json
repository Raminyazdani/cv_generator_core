{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cover-letter.schema.json",
  "title": "Cover Letter JSON Configuration",
  "description": "Schema reconstructed from Raminyazdani/cv_generator_core cover-letter code, templates, tests, and docs. The code validates only meta.type and top-level required keys, while this schema also captures documented/template-required inner fields.",
  "type": "object",
  "required": [
    "meta",
    "sender",
    "recipient",
    "letter",
    "sections"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "cover_letter",
          "description": "Required document marker. Files are skipped unless meta.type equals cover_letter."
        },
        "version": {
          "type": "string",
          "examples": [
            "1.0"
          ]
        }
      }
    },
    "sender": {
      "$ref": "#/$defs/sender"
    },
    "recipient": {
      "$ref": "#/$defs/recipient"
    },
    "job": {
      "$ref": "#/$defs/job"
    },
    "letter": {
      "$ref": "#/$defs/letter"
    },
    "sections": {
      "type": "array",
      "description": "Ordered body sections rendered by body_sections.tex.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "options": {
      "$ref": "#/$defs/options"
    }
  },
  "$defs": {
    "sender": {
      "type": "object",
      "description": "Applicant data. Can be inline or loaded from sender.cv_data_path and overridden by inline fields.",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "cv_data_path"
          ]
        },
        {
          "required": [
            "first_name",
            "last_name"
          ]
        }
      ],
      "properties": {
        "cv_data_path": {
          "type": "string",
          "description": "Relative or absolute path to a CV JSON file. Relative paths are resolved first relative to the cover-letter JSON file."
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "position": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Professional title. Docs use string; some templates/tests expect direct rendering."
        },
        "address": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "photo": {
          "description": "Photo config. String form is enabled only when options.show_photo is true. Object form can control enabled/path/style.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/photo"
            }
          ]
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "path"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "style": {
          "oneOf": [
            {
              "type": "string",
              "description": "Comma-separated style options; normalized by code."
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "examples": [
            [
              "circle",
              "noedge",
              "left"
            ],
            "circle,noedge,left"
          ]
        }
      }
    },
    "recipient": {
      "type": "object",
      "description": "Company or named recipient. At least one of company/person_name is required by the documented schema.",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "company"
          ]
        },
        {
          "required": [
            "person_name"
          ]
        }
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "person_name": {
          "type": "string"
        },
        "person_title": {
          "type": "string"
        },
        "address_lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "job": {
      "type": "object",
      "description": "Optional application metadata. Current fetched templates do not directly render these fields unless referenced by custom templates.",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "posting_url": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "employment_type": {
          "type": "string"
        }
      }
    },
    "letter": {
      "type": "object",
      "description": "Letter metadata rendered by letter_meta.tex, signature.tex, enclosures.tex, and output naming logic.",
      "additionalProperties": true,
      "required": [
        "date",
        "opening",
        "closing"
      ],
      "properties": {
        "date": {
          "type": "string",
          "description": "Rendered as \\letterdate. If absent in template, \\today is used, but docs mark it required."
        },
        "title": {
          "type": "string",
          "description": "Subject/title rendered as \\lettertitle."
        },
        "opening": {
          "type": "string",
          "description": "Salutation rendered as \\letteropening."
        },
        "closing": {
          "type": "string",
          "description": "Sign-off rendered as \\letterclosing."
        },
        "enclosures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joined with comma by enclosures.tex."
        },
        "signature_name": {
          "type": "string",
          "description": "If absent, normalized to sender.first_name + sender.last_name."
        },
        "language": {
          "type": "string",
          "description": "Overrides filename-derived language. fa/ar/he trigger RTL unless options.rtl overrides.",
          "examples": [
            "en",
            "de",
            "fa",
            "ar",
            "he"
          ]
        },
        "output_name": {
          "type": "string",
          "description": "Custom output PDF name. Code appends .pdf if missing; if absent, uses <base_name>_<lang>_cover_letter."
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable body section identifier. Used for organization and future template targeting."
        },
        "title": {
          "type": "string",
          "description": "Optional visible heading rendered with \\lettersection{...}."
        },
        "content": {
          "description": "Body content. String renders one paragraph; array renders ordered paragraphs separated by blank lines.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "options": {
      "type": "object",
      "description": "Rendering/layout options used by cover-letter build code and templates.",
      "additionalProperties": true,
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "default",
            "compact",
            "rtl",
            "awesomecv_sectioned"
          ],
          "default": "default",
          "description": "Layout selector. If RTL mode is true, code auto-selects the rtl layout regardless of this value."
        },
        "layout_variant": {
          "type": "string",
          "default": "standard",
          "description": "Documented option; no direct use found in fetched build code/templates."
        },
        "color_theme": {
          "type": "string",
          "enum": [
            "blue",
            "red",
            "orange",
            "pink",
            "emerald",
            "darkgray",
            "concrete"
          ],
          "description": "Template-supported named color choices. Other strings are not validated by code but fall through to default colors in templates."
        },
        "show_photo": {
          "type": "boolean",
          "default": false,
          "description": "Legacy photo toggle used when sender.photo is a string or rich photo enabled is omitted."
        },
        "rtl": {
          "type": "boolean",
          "description": "Force RTL/LTR. If absent, RTL is auto-detected for fa, ar, he."
        },
        "compile": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Number of xelatex compile runs for cover letters."
            }
          }
        },
        "header_alignment": {
          "type": "string",
          "enum": [
            "L",
            "C",
            "R"
          ],
          "default": "R",
          "description": "Used by the awesomecv_sectioned layout."
        },
        "font_dir": {
          "type": "string",
          "description": "Used by the awesomecv_sectioned layout as \\fontdir[...]."
        },
        "geometry": {
          "type": "object",
          "additionalProperties": true,
          "description": "Used by the awesomecv_sectioned layout.",
          "properties": {
            "left": {
              "type": "string"
            },
            "top": {
              "type": "string"
            },
            "right": {
              "type": "string"
            },
            "bottom": {
              "type": "string"
            },
            "footskip": {
              "type": "string"
            }
          }
        },
        "footer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "show_page_number": {
              "type": "boolean",
              "default": true,
              "description": "Only awesomecv_sectioned checks this; false removes the page number."
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "meta": {
        "type": "cover_letter",
        "version": "1.0"
      },
      "sender": {
        "cv_data_path": "../cvs/ramin_en.json",
        "position": "Bioinformatics Researcher"
      },
      "recipient": {
        "company": "TechCorp GmbH",
        "department": "Engineering"
      },
      "letter": {
        "date": "2026-03-10",
        "opening": "Dear Hiring Team,",
        "closing": "Sincerely,"
      },
      "sections": [
        {
          "id": "motivation",
          "content": "I am writing to express my interest."
        }
      ],
      "options": {
        "template": "compact",
        "color_theme": "blue",
        "show_photo": false
      }
    }
  ]
}